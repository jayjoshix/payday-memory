# Copy to .env.local locally. Never paste credentials into chat or commit .env.local.
# Random local operator bearer secret, at least 24 characters. Does not fund anything.
PAYDAY_OPERATOR_TOKEN=
PORT=4173

# Tatum dashboard API key, with no payment arrangement or automatic paid upgrade.
TATUM_API_KEY=
# Public Sui address only; does not establish an owner's identity.
TATUM_PUBLIC_ADDRESS=
# Optional known public transaction digest for a receipt inspection.
TATUM_TRANSACTION_DIGEST=

# Official Walrus Memory application SDK delegate credential (secret).
# MEMWAL_AGENT_ID is the public delegate key, not MEMWAL_KEY or the account object ID.
MEMWAL_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_AGENT_ID=
MEMWAL_NAMESPACE=payday-memory-fictional-v1

# Sponsor commands also require timestamped local data/account-checks.json.
# Copy evidence/account-checks.example.json; false/zero defaults block live calls.
# See docs/sponsor-research.md and README.md before enabling any live operation.
